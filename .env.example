# Copy to .env (git-ignored) and fill in. Never commit real keys.

# Key that clients send in the X-API-Key header. Generate one with: openssl rand -hex 24
STORYBUILDER_API_KEY=change-me

# fal.ai API key for FLUX illustrations (https://fal.ai/dashboard/keys). Empty = offline placeholder art.
FAL_KEY=

# Scene director (Ollama).
#   Mac with native Ollama:                          http://host.docker.internal:11434
#   Linux with `docker compose --profile ollama up`: http://ollama:11434
#   Another machine on the LAN:                      http://<its-ip>:11434
#     (that machine must listen on all interfaces: OLLAMA_HOST=0.0.0.0:11434)
STORYBUILDER_LLM_BASE_URL=http://host.docker.internal:11434
STORYBUILDER_LLM_MODEL=llama3.2:3b

# piper (natural neural voice) | espeak (lightweight fallback)
STORYBUILDER_TTS_ENGINE=piper
